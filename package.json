{
  "name": "@chunkify/cli",
  "version": "0.7.0",
  "description": "Chunkify CLI for video transcoding and local webhook forwarding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunkifydev/cli.git"
  },
  "homepage": "https://chunkify.dev/docs/cli",
  "bin": {
    "chunkify": "npm/bin/chunkify.cjs"
