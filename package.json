  "scripts": {
    "prepack": "node scripts/build-npm.cjs",
    "test": "node --test npm/test/*.test.cjs",
    "test:install": "node scripts/test-npm.cjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
